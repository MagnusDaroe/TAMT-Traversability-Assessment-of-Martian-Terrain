<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cost_module</name>
  <version>0.0.1</version>
  <description>ROS 2 package for generating cost maps from SNE and Segmentation</description>
  <maintainer email="sdonsl22@student.aau.dk">Simon</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend> 
  <build_depend>interfaces</build_depend>
  <exec_depend>interfaces</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- ROS 2 Python dependencies -->
  <depend>rclpy</depend>

  <!-- System dependencies -->
  <!-- <depend>libopencv-dev</depend> -->

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>